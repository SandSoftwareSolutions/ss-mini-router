{
  "name": "@sandsoftwaresolutions/mini-router",
  "version": "0.1.1",
  "description": "A tiny router for node:http: params, JSON bodies with limits, middleware, and errors that never leak.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "router",
    "http",
    "api",
    "server",
    "micro"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-mini-router.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-mini-router/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-mini-router#readme",
  "publishConfig": {
    "access": "public"
  }
}
